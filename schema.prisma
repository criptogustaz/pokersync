// PostgreSQL + Prisma
// datasource e generator ficam no topo do seu schema.prisma existente:
//
//   datasource db { provider = "postgresql"; url = env("DATABASE_URL") }
//   generator client { provider = "prisma-client-js" }

// ---------------------------------------------------------------------------
// ENUMS — o banco recusa valor fora da lista, então erro de digitação no seed
// vira falha de inserção em vez de dado silenciosamente errado.
// ---------------------------------------------------------------------------

enum Position {
  UTG
  UTG1  @map("UTG+1")
  LJ
  HJ
  CO
  BTN
  SB
  BB
}

enum PotType {
  SRP     // pote de raise simples
  THREEBET @map("3BET")
  FOURBET  @map("4BET")
}

enum Street {
  PREFLOP
  FLOP
  TURN
  RIVER
}

enum ActionType {
  FOLD
  CHECK
  CALL
  BET
  RAISE
  ALLIN
}

/// Como a resposta correta foi obtida. É o campo mais importante da tabela:
/// separa o que é matemática do que é opinião, e permite servir só o confiável.
enum MathMethod {
  EXACT_ENUMERATION   // enumeração completa: river fechado ou all-in
  NASH_EQUILIBRIUM    // ponto fixo resolvido, push/fold
  SOLVER_IMPORT       // saída de solver externo (Pio, GTO+), com metadados
  HEURISTIC           // julgamento humano — NÃO servir como gabarito
}

/// Grau de confiança na resposta. A API filtra por isso.
enum Confidence {
  EXACT               // não depende de premissa
  EXACT_GIVEN_RANGE   // cálculo exato, mas condicionado à range assumida
  ESTIMATED           // aproximado
  UNVERIFIED          // sem verificação
}

// ---------------------------------------------------------------------------
// DRILL
// ---------------------------------------------------------------------------

model Drill {
  id        String   @id                    // "srp-01", vindo do JSON
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- cenário ---
  heroHand        String     @db.VarChar(5)   // "Ad Qc"
  board           String     @db.VarChar(14)  // "Qs 7h 3d 5c 4s"
  street          Street
  heroPosition    Position
  villainPosition Position

  potBbs      Decimal @db.Decimal(8, 2)      // pote ANTES da aposta do vilão
  betBbs      Decimal @db.Decimal(8, 2)
  betPctPot   Int
  stackBbs    Decimal @db.Decimal(8, 2)
  spr         Decimal @db.Decimal(6, 2)

  potType       PotType
  boardTexture  String  @db.VarChar(120)
  scenarioNote  String? @db.VarChar(240)

  // --- premissa: a range do vilão viaja com o drill, para poder ser auditada ---
  rangeValueNotation String  @db.Text          // combos que batem o herói
  rangeWorseNotation String  @db.Text          // combos que o herói bate
  rangeTotalCombos   Int

  // --- cálculo ---
  mathMethod        MathMethod
  confidence        Confidence
  equityPct         Decimal @db.Decimal(5, 2)
  potOddsNeededPct  Decimal @db.Decimal(5, 2)
  marginPp          Decimal @db.Decimal(6, 2) // equity - pot odds; sinal define a resposta
  evCallBbs         Decimal @db.Decimal(8, 2)
  evFoldBbs         Decimal @db.Decimal(8, 2) @default(0)
  combosHeroBeats   Int?
  combosBeatingHero Int?
  combosTie         Int?

  correctAction ActionType
  explanation   String     @db.Text
  caveat        String?    @db.Text           // limitação declarada da fonte

  /// Fora do ar sem apagar: usado quando uma premissa é contestada.
  isActive Boolean @default(true)

  options   DrillOption[]
  responses DrillResponse[]

  // ---------- índices ----------
  // O índice composto cobre o filtro mais comum da API (stack + posição + textura)
  // na ordem em que os campos são usados; sozinhos, os três primeiros também servem
  // consultas parciais da esquerda para a direita.
  @@index([stackBbs, heroPosition, boardTexture], name: "idx_drill_busca_principal")
  @@index([stackBbs])
  @@index([heroPosition])
  @@index([boardTexture])
  @@index([potType, street])
  // Só drills confiáveis e ativos devem chegar ao usuário: este índice serve o WHERE
  @@index([isActive, confidence, mathMethod], name: "idx_drill_confiavel")
  @@map("drills")
}

model DrillOption {
  id        String     @id @default(cuid())
  drillId   String
  drill     Drill      @relation(fields: [drillId], references: [id], onDelete: Cascade)

  action    ActionType
  amountBbs Decimal    @db.Decimal(8, 2) @default(0)
  isCorrect Boolean
  evBbs     Decimal    @db.Decimal(8, 2)
  ordering  Int        @default(0)

  responses DrillResponse[]

  @@unique([drillId, action], name: "uq_opcao_por_drill")
  @@index([drillId])
  @@map("drill_options")
}

// ---------------------------------------------------------------------------
// HISTÓRICO — a base da análise de leaks
// ---------------------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  responses DrillResponse[]
  sessions  DrillSession[]
  @@map("users")
}

/// Uma sessão de treino. Agrupar respostas permite medir evolução no tempo
/// e separar "errei cansado às 2h" de "não sei este spot".
model DrillSession {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  filterStack    Int?
  filterPosition Position?
  filterPotType  PotType?

  responses DrillResponse[]

  @@index([userId, startedAt])
  @@map("drill_sessions")
}

model DrillResponse {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  drillId   String
  drill     Drill    @relation(fields: [drillId], references: [id], onDelete: Cascade)
  sessionId String?
  session   DrillSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  chosenOptionId String?
  chosenOption   DrillOption? @relation(fields: [chosenOptionId], references: [id], onDelete: SetNull)

  chosenAction ActionType
  isCorrect    Boolean
  /// Custo do erro em bb — 0 quando acertou. É esta coluna que ordena os leaks:
  /// errar por 0,2bb não é o mesmo problema que errar por 12bb.
  evLostBbs    Decimal  @db.Decimal(8, 2)
  timeMs       Int

  // Cópias desnormalizadas do cenário. Repetição proposital: permite agregar
  // leaks sem JOIN e mantém o histórico intacto se o drill for editado depois.
  snapshotPosition Position
  snapshotPotType  PotType
  snapshotStreet   Street
  snapshotStackBbs Decimal @db.Decimal(8, 2)
  snapshotTexture  String  @db.VarChar(120)

  // ---------- índices para os relatórios de leak ----------
  @@index([userId, createdAt])
  @@index([userId, isCorrect])
  @@index([userId, snapshotPosition, snapshotPotType], name: "idx_leak_por_contexto")
  @@index([userId, snapshotTexture])
  @@index([drillId])
  @@map("drill_responses")
}

// ---------------------------------------------------------------------------
// Consultas de leak que estes índices sustentam:
//
// 1. Onde o usuário perde mais EV, por contexto:
//    SELECT snapshot_position, snapshot_pot_type,
//           COUNT(*) AS maos,
//           SUM(ev_lost_bbs) AS ev_perdido,
//           AVG(CASE WHEN is_correct THEN 1.0 ELSE 0 END) AS acerto
//      FROM drill_responses
//     WHERE user_id = $1
//     GROUP BY 1, 2
//     ORDER BY ev_perdido DESC;
//
// 2. Texturas de board problemáticas (mínimo de amostra para não tirar
//    conclusão de 3 mãos):
//    SELECT snapshot_texture, COUNT(*) AS n, SUM(ev_lost_bbs) AS ev
//      FROM drill_responses
//     WHERE user_id = $1
//     GROUP BY 1 HAVING COUNT(*) >= 10
//     ORDER BY ev DESC;
//
// 3. Viés de ação — o clássico "pago demais" ou "folda demais":
//    SELECT chosen_action, COUNT(*) FILTER (WHERE NOT is_correct) AS erros
//      FROM drill_responses WHERE user_id = $1 GROUP BY 1;
// ---------------------------------------------------------------------------
